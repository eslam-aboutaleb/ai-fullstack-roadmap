{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "updated",
    "description",
    "review_status",
    "units"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "minLength": 30
    },
    "review_status": {
      "type": "string",
      "minLength": 8
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "study_id",
          "title",
          "outcomes",
          "terms",
          "narrative",
          "lab",
          "practice",
          "debugging",
          "tradeoffs",
          "references",
          "prerequisites",
          "estimated_minutes",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "study_id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 8
          },
          "outcomes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "terms": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "term",
                "definition"
              ],
              "properties": {
                "term": {
                  "type": "string",
                  "minLength": 2
                },
                "definition": {
                  "type": "string",
                  "minLength": 12
                }
              }
            }
          },
          "narrative": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string",
              "minLength": 80
            }
          },
          "lab": {
            "type": "string",
            "minLength": 4
          },
          "practice": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "debugging": {
            "type": "string",
            "minLength": 40
          },
          "tradeoffs": {
            "type": "string",
            "minLength": 40
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 5
          },
          "path": {
            "type": "string",
            "enum": [
              "core",
              "elective"
            ]
          }
        }
      }
    }
  }
}
