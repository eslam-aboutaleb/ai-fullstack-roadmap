{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "updated",
    "description",
    "review_status",
    "units"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "minLength": 30
    },
    "review_status": {
      "type": "string",
      "minLength": 8
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "study_id",
          "title",
          "outcomes",
          "terms",
          "narrative",
          "lab",
          "practice",
          "debugging",
          "tradeoffs",
          "references",
          "prerequisites",
          "estimated_minutes",
          "path",
          "worked_examples",
          "interviews"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "study_id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 8
          },
          "outcomes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "terms": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "term",
                "definition"
              ],
              "properties": {
                "term": {
                  "type": "string",
                  "minLength": 2
                },
                "definition": {
                  "type": "string",
                  "minLength": 12
                }
              }
            }
          },
          "narrative": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string",
              "minLength": 80
            }
          },
          "lab": {
            "type": "string",
            "minLength": 4
          },
          "practice": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "debugging": {
            "type": "string",
            "minLength": 40
          },
          "tradeoffs": {
            "type": "string",
            "minLength": 40
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 5
          },
          "path": {
            "type": "string",
            "enum": [
              "core",
              "elective"
            ]
          },
          "worked_examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "title",
                "setup",
                "steps",
                "result"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 10
                },
                "setup": {
                  "type": "string",
                  "minLength": 20
                },
                "steps": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 10
                  }
                },
                "result": {
                  "type": "string",
                  "minLength": 20
                }
              }
            }
          },
          "interviews": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "question",
                "spoken",
                "deep",
                "follow_up",
                "rubric"
              ],
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 10
                },
                "spoken": {
                  "type": "string",
                  "minLength": 40
                },
                "deep": {
                  "type": "string",
                  "minLength": 60
                },
                "follow_up": {
                  "type": "object",
                  "required": [
                    "question",
                    "answer"
                  ],
                  "properties": {
                    "question": {
                      "type": "string",
                      "minLength": 10
                    },
                    "answer": {
                      "type": "string",
                      "minLength": 25
                    }
                  }
                },
                "rubric": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 10
                  }
                }
              }
            }
          },
          "incident": {
            "type": "object",
            "required": [
              "symptom",
              "evidence",
              "investigation",
              "recovery",
              "prevention"
            ],
            "properties": {
              "symptom": {
                "type": "string",
                "minLength": 25
              },
              "evidence": {
                "type": "string",
                "minLength": 25
              },
              "investigation": {
                "type": "string",
                "minLength": 25
              },
              "recovery": {
                "type": "string",
                "minLength": 25
              },
              "prevention": {
                "type": "string",
                "minLength": 25
              }
            }
          },
          "project": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "source_context": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "reference_id",
                "explanation",
                "boundary",
                "accessed_at"
              ],
              "properties": {
                "reference_id": {
                  "type": "string",
                  "minLength": 3
                },
                "explanation": {
                  "type": "string",
                  "minLength": 20
                },
                "boundary": {
                  "type": "string",
                  "minLength": 20
                },
                "accessed_at": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      }
    }
  }
}
