{
  "type": "object",
  "required": [
    "Q",
    "A",
    "Why",
    "Risk",
    "Trade",
    "Try",
    "worked_case",
    "citations",
    "reviewer_status",
    "answer_format"
  ],
  "properties": {
    "answer_format": {
      "type": "string",
      "enum": [
        "conceptual"
      ]
    },
    "A": {
      "type": "string",
      "minLength": 350
    },
    "worked_case": {
      "type": "string",
      "minLength": 100
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 15
      }
    },
    "reviewer_status": {
      "type": "object",
      "required": [
        "status",
        "reviewer"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
