{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Textbook-grade interview question schema",
  "description": "Schema for a practice/interview question. Separates the concise spoken interview answer (60-120 seconds) from the comprehensive deep explanation. No word cap on long-form answers.",
  "type": "object",
  "required": [
    "Q",
    "spoken",
    "A",
    "domain",
    "subdomain",
    "difficulty",
    "misconception_target",
    "definitions",
    "execution_timeline",
    "example",
    "production_case",
    "alternatives",
    "pitfalls",
    "complexity",
    "follow_ups",
    "citations",
    "reviewer_status"
  ],
  "properties": {
    "Q": {
      "type": "string",
      "minLength": 5,
      "description": "The question prompt"
    },
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "Stable opaque study ID assigned by the build system"
    },
    "spoken": {
      "type": "string",
      "minLength": 60,
      "description": "Concise spoken interview answer; length depends on the question."
    },
    "A": {
      "type": "string",
      "minLength": 100,
      "description": "Comprehensive deep explanation; no truncation or word cap"
    },
    "domain": {
      "type": "string",
      "enum": [
        "foundations",
        "backend",
        "frontend",
        "ai-rag",
        "agents",
        "operations",
        "system-design",
        "mathematics",
        "ml",
        "deep-learning",
        "transformers",
        "inference",
        "evaluation",
        "data-engineering",
        "cloud-mlops"
      ],
      "description": "Topical domain"
    },
    "subdomain": {
      "type": "string",
      "minLength": 2,
      "description": "Subdomain within the domain"
    },
    "module": {
      "type": "string",
      "minLength": 2,
      "description": "Module/chapter containing this question"
    },
    "concept": {
      "type": "string",
      "minLength": 2,
      "description": "Specific concept within the module"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "foundations",
        "mechanism",
        "implementation",
        "debugging",
        "performance",
        "security",
        "design",
        "tradeoffs",
        "scenario",
        "interview"
      ],
      "description": "Question difficulty facet"
    },
    "misconception_target": {
      "type": "string",
      "minLength": 10,
      "description": "The specific misconception this question targets"
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "definition"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "definition": {
            "type": "string",
            "minLength": 5
          }
        }
      },
      "minItems": 1,
      "description": "Definitions of all important terms used in the question and answer"
    },
    "execution_timeline": {
      "type": "string",
      "minLength": 20,
      "description": "Internal execution timeline: what happens step by step"
    },
    "example": {
      "type": "object",
      "required": [
        "code",
        "explanation",
        "output"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 5
        },
        "explanation": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      },
      "description": "At least one runnable example where applicable"
    },
    "production_case": {
      "type": "string",
      "minLength": 20,
      "description": "Real production case or scenario illustrating the concept"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Alternative approaches and when each applies"
    },
    "pitfalls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Common pitfalls and failure modes"
    },
    "complexity": {
      "type": "string",
      "minLength": 10,
      "description": "Time/space complexity and cost characteristics"
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Q",
          "A"
        ],
        "properties": {
          "Q": {
            "type": "string"
          },
          "A": {
            "type": "string"
          }
        }
      },
      "minItems": 1,
      "description": "Follow-up questions with full answers"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Authoritative primary references"
    },
    "reviewer_status": {
      "type": "object",
      "required": [
        "reviewer",
        "reviewed_at",
        "status"
      ],
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "approved",
            "deprecated"
          ]
        }
      }
    },
    "added": {
      "type": "boolean",
      "description": "True when this question was added in the current curriculum edition"
    },
    "Why": {
      "type": "string"
    },
    "Risk": {
      "type": "string"
    },
    "Trade": {
      "type": "string"
    },
    "Try": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
