{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Textbook-grade lesson schema",
  "description": "Schema for a guided lesson question within a chapter. Every field is required unless marked optional; validation blocks missing critical fields and unexplained jargon.",
  "type": "object",
  "required": [
    "Q",
    "outcomes",
    "estimated_time_minutes",
    "prerequisites",
    "version",
    "references",
    "conceptual_narrative",
    "glossary_terms",
    "worked_examples",
    "syntax_highlighted_source",
    "expected_output",
    "debugging",
    "security_implications",
    "performance_implications",
    "local_lab",
    "independent_tasks",
    "review_and_answer_keys"
  ],
  "properties": {
    "Q": {
      "type": "string",
      "minLength": 5,
      "description": "The lesson's central question, as a learner would ask it"
    },
    "spoken": {
      "type": "string",
      "minLength": 60,
      "description": "Concise spoken interview answer; length depends on the question."
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "minItems": 2,
      "description": "Measurable learning outcomes; each starts with a verb"
    },
    "estimated_time_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120,
      "description": "Estimated time to read and work the lesson"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Concepts or prior lessons required before this lesson"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this lesson"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Authoritative primary sources"
    },
    "conceptual_narrative": {
      "type": "string",
      "minLength": 100,
      "description": "Mechanism-first textbook narrative explaining internal mechanics and intuition"
    },
    "glossary_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "definition"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "definition": {
            "type": "string",
            "minLength": 5
          }
        }
      },
      "description": "Terms defined at first use; no unexplained jargon"
    },
    "mathematical_derivations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Step-by-step equation derivations with dimensions and numeric worked examples"
    },
    "worked_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "code",
          "explanation"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        }
      },
      "minItems": 1,
      "description": "Runnable annotated examples with expected output"
    },
    "syntax_highlighted_source": {
      "type": "string",
      "description": "Primary source file content, syntax highlighted in build"
    },
    "expected_output": {
      "type": "string",
      "description": "Expected terminal/program output for the worked example"
    },
    "visualizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "alt",
          "description",
          "svg"
        ],
        "properties": {
          "alt": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "svg": {
            "type": "string"
          }
        }
      },
      "description": "Original instructional diagrams with alt text and long description"
    },
    "debugging": {
      "type": "string",
      "minLength": 20,
      "description": "Common failure modes and how to diagnose them"
    },
    "security_implications": {
      "type": "string",
      "minLength": 20,
      "description": "Security considerations and least-privilege guidance"
    },
    "performance_implications": {
      "type": "string",
      "minLength": 20,
      "description": "Complexity, latency, and resource tradeoffs"
    },
    "local_lab": {
      "type": "string",
      "description": "Path to a downloadable local lab; optional dependencies must be documented."
    },
    "independent_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Exercises the learner completes without provided answers"
    },
    "review_and_answer_keys": {
      "type": "object",
      "required": [
        "reviewer",
        "reviewed_at",
        "known_limitations"
      ],
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "known_limitations": {
          "type": "string"
        }
      }
    },
    "added": {
      "type": "boolean",
      "description": "True when this lesson was added in the current curriculum edition"
    },
    "id": {
      "type": "integer"
    },
    "explain": {
      "type": "string"
    },
    "example": {
      "type": "string"
    },
    "takeaway": {
      "type": "string"
    },
    "assumed_knowledge": {
      "type": "string"
    },
    "motivating_problem": {
      "type": "string"
    },
    "conceptual_model": {
      "type": "string"
    },
    "underlying_mechanics": {
      "type": "string"
    },
    "line_by_line": {
      "type": "array"
    },
    "edge_cases": {
      "type": "array"
    },
    "tradeoffs": {
      "type": "string"
    },
    "practice": {
      "type": "string"
    },
    "recap": {
      "type": "string"
    },
    "mastery_checks": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
